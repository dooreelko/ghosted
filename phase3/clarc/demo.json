      "commands": [
        "clarc --file steps/00-first-render/graph.clarc.json > steps/00-first-render/graph.drawio",
        "drawio -x -f png -s 0.5 -o steps/00-first-render/graph.png steps/00-first-render/graph.drawio --no-sandbox"
