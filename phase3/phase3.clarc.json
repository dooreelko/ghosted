{
  "title": "Phase 3: serverless Ghost",
  "description": "Static public site in S3 behind CloudFront; one API Gateway HTTP API routes dynamic, admin and render requests to classic Lambda functions; background work on schedules",
  "nodes": [
    {
      "id": "viewer",
      "label": "Viewer / admin (browser)",
      "service": "client"
    },
    {
      "id": "dns",
      "label": "DNS zone",
      "service": "route_53"
    },
    {
      "id": "cdn",
      "label": "CloudFront (path behaviors)",
      "service": "cloudfront"
    },
    {
      "id": "content",
      "label": "Content bucket (HTML, images)",
      "service": "s3"
    },
    {
      "id": "apigw",
      "label": "API Gateway HTTP API (routes, throttling)",
      "service": "api_gateway"
    },
    {
      "id": "readers",
      "label": "Reader-facing functions: image-resize, link-redirect, members-session, comments, webmentions, content-api",
      "service": "lambda"
    },
    {
      "id": "admin",
      "label": "Admin functions: content, audience, site, heavy",
      "service": "lambda"
    },
    {
      "id": "gen",
      "label": "Render functions: generator (+ image variant preflight), preview",
      "service": "lambda"
    },
    {
      "id": "bg",
      "label": "Background functions: scheduled-publish, email-send, maintenance, checkpoint",
      "service": "lambda"
    },
    {
      "id": "events",
      "label": "EventBridge schedules",
      "service": "eventbridge"
    },
    {
      "id": "data",
      "label": "SQLite store bucket",
      "service": "s3"
    },
    {
      "id": "smtp",
      "label": "SMTP provider",
      "service": "traditional_server"
    },
    {
      "id": "ssm",
      "label": "Parameter Store (secrets)",
      "service": "parameter_store"
    },
    {
      "id": "cw",
      "label": "CloudWatch",
      "service": "cloudwatch_2"
    },
    {
      "id": "queue",
      "label": "Generate queue (+ dead-letter)",
      "service": "sqs"
    }
  ],
  "edges": [
    {
      "from": "viewer",
      "to": "cdn",
      "label": "HTTPS"
    },
    {
      "from": "dns",
      "to": "cdn",
      "label": "DNS",
      "kind": "nf"
    },
    {
      "from": "cdn",
      "to": "content",
      "label": "default: static pages, images"
    },
    {
      "from": "cdn",
      "to": "apigw",
      "label": "dynamic paths"
    },
    {
      "from": "readers",
      "to": "content",
      "label": "write image variants"
    },
    {
      "from": "admin",
      "to": "content",
      "label": "presigned uploads"
    },
    {
      "from": "admin",
      "to": "queue",
      "label": "site changed"
    },
    {
      "from": "admin",
      "to": "bg",
      "label": "newsletter send"
    },
    {
      "from": "gen",
      "to": "content",
      "label": "write HTML"
    },
    {
      "from": "events",
      "to": "bg",
      "label": "one-shot + recurring"
    },
    {
      "from": "bg",
      "to": "queue",
      "label": "scheduled publish"
    },
    {
      "from": "bg",
      "to": "smtp",
      "label": "SMTP"
    },
    {
      "from": "readers",
      "to": "data",
      "label": "read/write + checkpoint"
    },
    {
      "from": "admin",
      "to": "data",
      "label": "read/write + checkpoint"
    },
    {
      "from": "bg",
      "to": "data",
      "label": "read/write + compact"
    },
    {
      "from": "gen",
      "to": "data",
      "label": "read snapshot"
    },
    {
      "from": "bg",
      "to": "ssm",
      "label": "SMTP credential",
      "kind": "nf"
    },
    {
      "from": "cdn",
      "to": "cw",
      "label": "access logs",
      "kind": "nf"
    },
    {
      "from": "bg",
      "to": "cw",
      "label": "metrics",
      "kind": "nf"
    },
    {
      "from": "apigw",
      "to": "admin",
      "label": "admin routes"
    },
    {
      "from": "apigw",
      "to": "readers",
      "label": "reader routes"
    },
    {
      "from": "queue",
      "to": "gen",
      "label": "trigger"
    }
  ],
  "hints": {
    "viewer": {
      "start": true
    },
    "dns": {
      "above": "events"
    },
    "content": {
      "rightOf": "cdn",
      "sameCol": "data"
    },
    "readers": {
      "rightOf": "cdn"
    },
    "admin": {
      "below": "readers"
    },
    "data": {
      "rightOf": "gen",
      "below": "content"
    },
    "bg": {
      "below": "admin"
    },
    "gen": {
      "sameRow": "bg",
      "rightOf": "bg",
      "above": "smtp"
    },
    "smtp": {
      "below": "gen",
      "sameCol": "gen"
    },
    "apigw": {
      "leftOf": "admin",
      "sameRow": "admin"
    },
    "queue": {
      "leftOf": "gen",
      "sameRow": "gen"
    }
  },
  "joinPorts": "all"
}