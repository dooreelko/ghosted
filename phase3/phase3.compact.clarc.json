      "id": "aws",
      "label": "AWS",
      "service": "aws-cloud"
    },
    {
      "id": "g_readers",
      "label": "6 reader-facing functions",
      "service": "group",
      "group": "aws"
    },
    {
      "id": "g_admin",
      "label": "4 admin functions",
      "service": "group",
      "group": "aws"
    },
    {
      "id": "g_gen",
