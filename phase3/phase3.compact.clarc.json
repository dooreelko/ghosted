{
  "title": "Phase 3: serverless Ghost (compact, per function group)",
  "description": "Same system as phase3, one node per function group: reader-facing (6), render (2), admin (4), background (4). The API also routes the preview function in the render group (edge left out to keep the layout readable). The deploy bucket only holds the code zip the functions are updated from",
  "groups": [
    {
      "id": "aws",
      "label": "AWS",
      "service": "aws-cloud"
    },
    {
      "id": "external",
      "label": "External services",
      "service": "group"
    },
    {
      "id": "g_readers",
      "label": "6 reader-facing functions",
      "service": "group",
      "group": "aws"
    },
    {
      "id": "g_admin",
      "label": "4 admin functions",
      "service": "group",
      "group": "aws"
    },
    {
      "id": "g_gen",
      "label": "2 render functions",
      "service": "group",
      "group": "aws"
    },
    {
      "id": "g_bg",
      "label": "4 background functions",
      "service": "group",
      "group": "aws"
    }
  ],
  "nodes": [
    {
      "id": "viewer",
      "label": "Viewer / admin (browser)",
      "service": "client"
    },
    {
      "id": "cdn",
      "label": "CloudFront (path behaviors, index function, anonymous member check, 404 page)",
      "service": "cloudfront",
      "group": "aws"
    },
    {
      "id": "content",
      "label": "Content bucket (HTML, images, admin client)",
      "service": "s3",
      "group": "aws"
    },
    {
      "id": "apigw",
      "label": "API Gateway HTTP API (routes, throttling)",
      "service": "api_gateway",
      "group": "aws"
    },
    {
      "id": "readers",
      "label": "image-resize, link-redirect, members-session, comments, webmentions, content-api",
      "service": "lambda",
      "group": "g_readers"
    },
    {
      "id": "admin",
      "label": "admin-content, admin-audience, admin-site, admin-heavy",
      "service": "lambda",
      "group": "g_admin"
    },
    {
      "id": "gen",
      "label": "generator, preview",
      "service": "lambda",
      "group": "g_gen"
    },
    {
      "id": "bg",
      "label": "scheduled-publish, email-send, maintenance, sqlite-checkpoint",
      "service": "lambda",
      "group": "g_bg"
    },
    {
      "id": "events",
      "label": "EventBridge Scheduler (recurring + one-shot)",
      "service": "eventbridge",
      "group": "aws"
    },
    {
      "id": "data",
      "label": "SQLite store bucket",
      "service": "s3",
      "group": "aws"
    },
    {
      "id": "smtp",
      "label": "SMTP provider",
      "service": "traditional_server",
      "group": "external"
    },
    {
      "id": "ssm",
      "label": "Parameter Store (secrets)",
      "service": "parameter_store",
      "group": "aws"
    },
    {
      "id": "cw",
      "label": "CloudWatch (access logs, alarms)",
      "service": "cloudwatch_2",
      "group": "aws"
    },
    {
      "id": "queue",
      "label": "Generate queue (+ dead-letter)",
      "service": "sqs",
      "group": "aws"
    },
    {
      "id": "dlq",
      "label": "Dead-letter queue",
      "service": "sqs",
      "group": "aws"
    },
    {
      "id": "sns",
      "label": "Alarm topic (email)",
      "service": "sns",
      "group": "aws"
    },
    {
      "id": "deploy",
      "label": "Deploy bucket (code zip)",
      "service": "s3",
      "group": "aws"
    },
    {
      "id": "mailgun",
      "label": "Mailgun (newsletter delivery, credentials in the store settings)",
      "service": "traditional_server",
      "group": "external"
    }
  ],
  "edges": [
    {
      "from": "viewer",
      "to": "cdn",
      "label": "HTTPS"
    },
    {
      "from": "cdn",
      "to": "content",
      "label": "default: static pages, images, admin client"
    },
    {
      "from": "cdn",
      "to": "apigw",
      "label": "dynamic paths"
    },
    {
      "from": "readers",
      "to": "content",
      "label": "image variants (resize)"
    },
    {
      "from": "admin",
      "to": "content",
      "label": "heavy: uploads, imports"
    },
    {
      "from": "admin",
      "to": "queue",
      "label": "site changed"
    },
    {
      "from": "admin",
      "to": "bg",
      "label": "newsletter send"
    },
    {
      "from": "gen",
      "to": "content",
      "label": "write HTML"
    },
    {
      "from": "events",
      "to": "bg",
      "label": "recurring"
    },
    {
      "from": "bg",
      "to": "queue",
      "label": "scheduled publish"
    },
    {
      "from": "bg",
      "to": "mailgun",
      "label": "newsletter send (HTTPS API)"
    },
    {
      "from": "readers",
      "to": "data",
      "label": "rw / ro"
    },
    {
      "from": "admin",
      "to": "data",
      "label": "rw"
    },
    {
      "from": "bg",
      "to": "data",
      "label": "rw"
    },
    {
      "from": "gen",
      "to": "data",
      "label": "ro"
    },
    {
      "from": "bg",
      "to": "ssm",
      "label": "SMTP credential",
      "kind": "nf"
    },
    {
      "from": "cdn",
      "to": "cw",
      "label": "access logs",
      "kind": "nf"
    },
    {
      "from": "bg",
      "to": "cw",
      "label": "metrics",
      "kind": "nf"
    },
    {
      "from": "apigw",
      "to": "admin",
      "label": "admin routes"
    },
    {
      "from": "apigw",
      "to": "readers",
      "label": "reader routes"
    },
    {
      "from": "queue",
      "to": "gen",
      "label": "trigger"
    },
    {
      "from": "bg",
      "to": "content",
      "label": "ro (email preflight)"
    },
    {
      "from": "admin",
      "to": "events",
      "label": "create one-shot"
    },
    {
      "from": "queue",
      "to": "dlq",
      "label": "after 3 tries"
    },
    {
      "from": "dlq",
      "to": "cw",
      "kind": "nf"
    },
    {
      "from": "gen",
      "to": "cw",
      "kind": "nf"
    },
    {
      "from": "apigw",
      "to": "cw",
      "kind": "nf"
    },
    {
      "from": "cw",
      "to": "sns",
      "label": "notify",
      "kind": "nf"
    },
    {
      "from": "admin",
      "to": "smtp",
      "label": "sign-in code"
    },
    {
      "from": "admin",
      "to": "ssm",
      "label": "SMTP credential",
      "kind": "nf"
    },
    {
      "from": "deploy",
      "to": "readers",
      "kind": "nf"
    },
    {
      "from": "deploy",
      "to": "admin",
      "kind": "nf"
    },
    {
      "from": "deploy",
      "to": "gen",
      "kind": "nf"
    },
    {
      "from": "deploy",
      "to": "bg",
      "kind": "nf"
    }
  ],
  "hints": {
    "viewer": {
      "start": true
    },
    "cdn": {
      "rightOf": "viewer",
      "sameRow": "viewer"
    },
    "apigw": {
      "rightOf": "cdn",
      "sameRow": "cdn"
    },
    "admin": {
      "rightOf": "apigw",
      "sameRow": "apigw"
    },
    "readers": {
      "below": "admin",
      "sameCol": "admin"
    },
    "bg": {
      "above": "admin",
      "sameCol": "admin"
    },
    "events": {
      "leftOf": "bg",
      "sameRow": "bg"
    },
    "queue": {
      "rightOf": "bg",
      "sameRow": "bg"
    },
    "gen": {
      "rightOf": "queue",
      "sameRow": "bg"
    },
    "content": {
      "below": "data",
      "sameCol": "data"
    },
    "data": {
      "rightOf": "admin",
      "sameRow": "admin",
      "sameCol": "gen"
    },
    "smtp": {
      "rightOf": "data",
      "sameRow": "data"
    },
    "ssm": {
      "above": "bg",
      "sameCol": "bg"
    },
    "dlq": {
      "above": "queue",
      "sameCol": "queue"
    },
    "cw": {
      "below": "readers",
      "sameCol": "readers"
    },
    "sns": {
      "leftOf": "cw",
      "sameRow": "cw"
    },
    "deploy": {
      "leftOf": "sns",
      "sameRow": "cw"
    },
    "mailgun": {
      "above": "smtp",
      "sameCol": "smtp"
    }
  },
  "joinPorts": "all"
}
